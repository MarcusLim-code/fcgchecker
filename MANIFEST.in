include README.md START_HERE.md pyproject.toml requirements*.lock .env.example
recursive-include .agents/skills SKILL.md
recursive-include docs *.md
recursive-include examples *.c *.md
recursive-include config *.toml
recursive-include research *.toml *.md
recursive-include scripts *.py
recursive-include skills *.md *.txt
recursive-include benchmarks/v2 *.json *.toml *.md
